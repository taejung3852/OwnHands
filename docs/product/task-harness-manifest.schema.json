{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taejung3852/own-hands/docs/product/task-harness-manifest.schema.json",
  "title": "ownhands Task Harness Manifest v1",
  "type": "object",
  "required": ["manifest_version", "manifest_id", "task", "context_sources", "control_sources", "instruction_overlay", "control_overlay", "event_refs", "evidence_refs", "generated_at"],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "task": {"$ref": "#/$defs/task"},
    "context_sources": {"type": "array", "items": {"$ref": "#/$defs/context_source"}, "uniqueItems": true},
    "control_sources": {"type": "array", "items": {"$ref": "#/$defs/control_source"}, "uniqueItems": true},
    "instruction_overlay": {"$ref": "#/$defs/instruction_overlay"},
    "control_overlay": {"$ref": "#/$defs/control_overlay"},
    "event_refs": {"$ref": "#/$defs/unique_strings"},
    "evidence_refs": {"$ref": "#/$defs/unique_strings"},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "unique_strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "task": {
      "type": "object",
      "required": ["project_id", "worktree_id", "task_id", "mode", "target_commit", "cwd", "environment_ref"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "worktree_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["managed", "imported"]},
        "target_commit": {"type": "string", "minLength": 1},
        "cwd": {"type": "string", "minLength": 1},
        "environment_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "locator": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["repository_path", "runtime_id", "managed_policy"]},
        "value": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["global", "project", "worktree", "task", "phase", "boundary"]},
        "value": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": ["status", "basis", "checked_at", "evidence_refs"],
      "properties": {
        "status": {"enum": ["current", "stale", "unknown"]},
        "basis": {"enum": ["observed", "inferred", "unobserved"]},
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "evidence_refs": {"$ref": "#/$defs/unique_strings"}
      },
      "allOf": [
        {"if": {"properties": {"basis": {"const": "observed"}}, "required": ["basis"]}, "then": {"properties": {"checked_at": {"type": "string", "format": "date-time"}, "evidence_refs": {"type": "array", "minItems": 1}}}},
        {"if": {"properties": {"basis": {"const": "unobserved"}}, "required": ["basis"]}, "then": {"properties": {"checked_at": {"type": "null"}, "evidence_refs": {"type": "array", "maxItems": 0}}}}
      ],
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "required": ["decision", "basis", "reason", "evidence_refs"],
      "properties": {
        "decision": {"enum": ["maintain", "add_for_task", "exclude_for_task", "replace_with_specific", "forbidden", "unobserved"]},
        "basis": {"enum": ["observed", "inferred", "unobserved"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/unique_strings"}
      },
      "allOf": [
        {"if": {"properties": {"basis": {"const": "observed"}}, "required": ["basis"]}, "then": {"properties": {"evidence_refs": {"type": "array", "minItems": 1}}}},
        {"if": {"properties": {"basis": {"const": "unobserved"}}, "required": ["basis"]}, "then": {"properties": {"decision": {"const": "unobserved"}, "evidence_refs": {"type": "array", "maxItems": 0}}}}
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["result", "basis", "evidence_refs", "inference_from", "checked_at", "exact_scope", "residual_risks"],
      "properties": {
        "result": {"enum": ["pass", "fail", "not_run", "not_applicable"]},
        "basis": {"enum": ["observed", "inferred", "unobserved"]},
        "evidence_refs": {"$ref": "#/$defs/unique_strings"},
        "inference_from": {"$ref": "#/$defs/unique_strings"},
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "exact_scope": {"type": "string"},
        "residual_risks": {"$ref": "#/$defs/unique_strings"}
      },
      "allOf": [
        {"if": {"properties": {"result": {"enum": ["pass", "fail", "not_applicable"]}}, "required": ["result"]}, "then": {"properties": {"basis": {"enum": ["observed", "inferred"]}}}},
        {"if": {"properties": {"result": {"const": "not_run"}}, "required": ["result"]}, "then": {"properties": {"basis": {"const": "unobserved"}, "evidence_refs": {"type": "array", "maxItems": 0}, "inference_from": {"type": "array", "maxItems": 0}, "checked_at": {"type": "null"}}}},
        {"if": {"properties": {"basis": {"const": "observed"}}, "required": ["basis"]}, "then": {"properties": {"evidence_refs": {"type": "array", "minItems": 1}, "checked_at": {"type": "string", "format": "date-time"}}}},
        {"if": {"properties": {"basis": {"const": "inferred"}}, "required": ["basis"]}, "then": {"properties": {"inference_from": {"type": "array", "minItems": 1}, "checked_at": {"type": "string", "format": "date-time"}}}}
      ],
      "additionalProperties": false
    },
    "realization": {
      "type": "object",
      "required": ["configured", "loaded", "enforced"],
      "properties": {"configured": {"$ref": "#/$defs/check"}, "loaded": {"$ref": "#/$defs/check"}, "enforced": {"$ref": "#/$defs/check"}},
      "additionalProperties": false
    },
    "source_base": {
      "type": "object",
      "required": ["source_id", "source_type", "locator", "content_hash", "version", "scope", "freshness", "applicability", "realization"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {"type": "string"},
        "locator": {"$ref": "#/$defs/locator"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "version": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/scope"},
        "freshness": {"$ref": "#/$defs/freshness"},
        "applicability": {"$ref": "#/$defs/applicability"},
        "realization": {"$ref": "#/$defs/realization"}
      },
      "additionalProperties": false
    },
    "context_source": {"type": "object", "$ref": "#/$defs/source_base", "properties": {"source_type": {"enum": ["agents_instruction", "instruction_overlay", "project_context", "reference", "skill", "task_instruction"]}}},
    "control_source": {"type": "object", "$ref": "#/$defs/source_base", "properties": {"source_type": {"enum": ["approval_policy", "control_config", "hook", "rule", "sandbox"]}}},
    "skill_invocation": {
      "type": "object",
      "required": ["source_ref", "reference_refs", "event_ref", "evidence_refs"],
      "properties": {"source_ref": {"type": "string", "minLength": 1}, "reference_refs": {"$ref": "#/$defs/unique_strings"}, "event_ref": {"type": "string", "minLength": 1}, "evidence_refs": {"$ref": "#/$defs/unique_strings"}},
      "additionalProperties": false
    },
    "instruction_overlay": {
      "type": "object",
      "required": ["source_refs", "skill_invocations", "excluded_source_refs"],
      "properties": {"source_refs": {"$ref": "#/$defs/unique_strings"}, "skill_invocations": {"type": "array", "items": {"$ref": "#/$defs/skill_invocation"}, "uniqueItems": true}, "excluded_source_refs": {"$ref": "#/$defs/unique_strings"}},
      "additionalProperties": false
    },
    "control_overlay": {
      "type": "object",
      "required": ["source_refs", "immutable_source_refs"],
      "properties": {"source_refs": {"$ref": "#/$defs/unique_strings"}, "immutable_source_refs": {"$ref": "#/$defs/unique_strings"}},
      "additionalProperties": false
    }
  }
}
