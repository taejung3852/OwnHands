{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taejung3852/devharness/docs/product/task-guarantee-report.schema.json",
  "title": "DevHarness Task Guarantee Report v1",
  "type": "object",
  "required": [
    "report_version",
    "matrix_version",
    "report_id",
    "task",
    "generated_at",
    "claim_results"
  ],
  "properties": {
    "report_version": {"const": "1.0"},
    "matrix_version": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "task": {
      "type": "object",
      "required": ["project_id", "worktree_id", "task_id", "mode", "target_commit"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "worktree_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["managed", "imported"]},
        "target_commit": {"type": "string", "minLength": 1},
        "environment_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "claim_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/claim_result"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "requirement_result": {
      "type": "object",
      "required": [
        "requirement_id",
        "result",
        "basis",
        "evidence_refs",
        "inference_from",
        "conflict_refs",
        "exact_scope"
      ],
      "properties": {
        "requirement_id": {"type": "string", "minLength": 1},
        "result": {
          "enum": [
            "pass",
            "fail",
            "not_run",
            "not_applicable",
            "no_adequate_test",
            "inconclusive",
            "unknown"
          ]
        },
        "basis": {"enum": ["observed", "inferred", "unobserved"]},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "inference_from": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "conflict_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "exact_scope": {"type": "string"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "not_applicable",
                  "no_adequate_test",
                  "inconclusive"
                ]
              }
            },
            "required": ["result"]
          },
          "then": {
            "properties": {
              "basis": {"enum": ["observed", "inferred"]}
            }
          }
        },
        {
          "if": {
            "properties": {"result": {"const": "not_run"}},
            "required": ["result"]
          },
          "then": {
            "properties": {
              "basis": {"const": "unobserved"},
              "evidence_refs": {"type": "array", "maxItems": 0},
              "inference_from": {"type": "array", "maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"result": {"const": "unknown"}},
            "required": ["result"]
          },
          "then": {
            "properties": {"basis": {"const": "unobserved"}}
          }
        },
        {
          "if": {
            "properties": {"basis": {"const": "observed"}},
            "required": ["basis"]
          },
          "then": {
            "properties": {"evidence_refs": {"type": "array", "minItems": 1}}
          }
        },
        {
          "if": {
            "properties": {"basis": {"const": "inferred"}},
            "required": ["basis"]
          },
          "then": {
            "properties": {"inference_from": {"type": "array", "minItems": 1}}
          }
        }
      ],
      "additionalProperties": false
    },
    "claim_result": {
      "type": "object",
      "required": [
        "claim_id",
        "verdict",
        "requirement_results",
        "control_validation_refs",
        "scope",
        "conflict_refs",
        "residual_risks",
        "permitted_statement",
        "evaluated_at"
      ],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^GM-[0-9]{3}$"},
        "verdict": {
          "enum": ["supported", "contradicted", "not_evaluated"]
        },
        "requirement_results": {
          "type": "array",
          "items": {"$ref": "#/$defs/requirement_result"}
        },
        "control_validation_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "scope": {"type": "string", "minLength": 1},
        "conflict_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "residual_risks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "permitted_statement": {"type": ["string", "null"]},
        "evaluated_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {"enum": ["contradicted", "not_evaluated"]}
            },
            "required": ["verdict"]
          },
          "then": {
            "properties": {"permitted_statement": {"type": "null"}}
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {"const": "supported"}
            },
            "required": ["verdict"]
          },
          "then": {
            "properties": {
              "requirement_results": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/requirement_result"},
                    {
                      "type": "object",
                      "properties": {
                        "result": {"const": "pass"},
                        "conflict_refs": {"type": "array", "maxItems": 0}
                      }
                    }
                  ]
                }
              },
              "conflict_refs": {"type": "array", "maxItems": 0},
              "permitted_statement": {"type": "string", "minLength": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
