{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taejung3852/devharness/docs/product/guarantee-matrix.schema.json",
  "title": "DevHarness Guarantee Matrix v1",
  "type": "object",
  "required": ["matrix_version", "source", "global_forbidden_wording", "claims"],
  "properties": {
    "matrix_version": {"const": "1.0"},
    "source": {
      "type": "object",
      "required": ["document", "section", "coverage_rule"],
      "properties": {
        "document": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "coverage_rule": {"const": "all_documented_core_claim_categories"}
      },
      "additionalProperties": false
    },
    "global_forbidden_wording": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "category",
        "claim",
        "applicable_task_modes",
        "required_realization_checks",
        "required_control_selectors",
        "required_evidence",
        "allowed_basis",
        "evaluation_rule",
        "forbidden_wording",
        "residual_risks"
      ],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^GM-[0-9]{3}$"},
        "category": {
          "enum": [
            "control_profile_created",
            "config_loaded",
            "agents_instruction_loaded",
            "rule_blocked_probe",
            "hook_invoked_event",
            "sandbox_blocked_boundary",
            "approval_applied_action",
            "config_conflict_identified",
            "mcp_tool_callable",
            "workspace_restore_point_created",
            "actual_changes_identified",
            "related_features_analyzed",
            "related_tests_executed",
            "defined_regression_scope_passed",
            "feature_directly_validated",
            "dashboard_fresh"
          ]
        },
        "claim": {"type": "string", "minLength": 1},
        "applicable_task_modes": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["managed", "imported"]},
          "uniqueItems": true
        },
        "required_realization_checks": {
          "type": "array",
          "items": {"enum": ["configured", "loaded", "enforced"]},
          "uniqueItems": true
        },
        "required_control_selectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["control_type", "check", "subject_requirement_id"],
            "properties": {
              "control_type": {
                "enum": [
                  "control_profile",
                  "active_config",
                  "agents_instruction",
                  "rule",
                  "sandbox",
                  "approval_policy"
                ]
              },
              "check": {"enum": ["configured", "loaded", "enforced"]},
              "subject_requirement_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["requirement_id", "type", "required_fields"],
            "properties": {
              "requirement_id": {"type": "string", "minLength": 1},
              "type": {
                "enum": [
                  "active_configuration",
                  "approval_lifecycle",
                  "configuration_conflict",
                  "direct_feature_probe",
                  "event_projection_sequence",
                  "feature_impact",
                  "file_creation",
                  "hook_execution",
                  "instruction_loading",
                  "mcp_capability",
                  "regression_gate",
                  "rule_probe",
                  "sandbox_probe",
                  "test_execution",
                  "workspace_diff",
                  "workspace_restore_point"
                ]
              },
              "required_fields": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "allowed_basis": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["observed", "inferred"]},
          "uniqueItems": true
        },
        "evaluation_rule": {
          "const": "all_required_pass_without_conflict"
        },
        "forbidden_wording": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "residual_risks": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
