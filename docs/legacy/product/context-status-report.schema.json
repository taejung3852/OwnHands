{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taejung3852/own-hands/docs/product/context-status-report.schema.json",
  "title": "ownhands Context Status report contract",
  "type": "object",
  "required": ["report_version", "matrix_version", "manifest_ref", "active_context", "active_controls", "excluded_context", "applicability_results", "lint_findings", "claim_results"],
  "properties": {
    "report_version": {"const": "1.0"},
    "matrix_version": {"const": "1.5-proposed-1"},
    "manifest_ref": {"type": "string", "minLength": 1},
    "active_context": {"type": "array", "items": {"$ref": "#/$defs/source_summary"}, "uniqueItems": true},
    "active_controls": {"type": "array", "items": {"$ref": "#/$defs/source_summary"}, "uniqueItems": true},
    "excluded_context": {"type": "array", "items": {"$ref": "#/$defs/excluded"}, "uniqueItems": true},
    "applicability_results": {"type": "array", "items": {"$ref": "#/$defs/applicability"}, "uniqueItems": true},
    "lint_findings": {"type": "array", "items": {"$ref": "#/$defs/lint"}, "uniqueItems": true},
    "claim_results": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/claim_result"}, "uniqueItems": true}
  },
  "additionalProperties": false,
  "$defs": {
    "refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "source_summary": {"type": "object", "required": ["source_ref", "evidence_refs"], "properties": {"source_ref": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}, "additionalProperties": false},
    "excluded": {"type": "object", "required": ["source_ref", "reason", "evidence_refs"], "properties": {"source_ref": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "evidence_refs": {"$ref": "#/$defs/refs"}}, "additionalProperties": false},
    "applicability": {"type": "object", "required": ["source_ref", "decision", "evidence_refs"], "properties": {"source_ref": {"type": "string", "minLength": 1}, "decision": {"enum": ["maintain", "add_for_task", "exclude_for_task", "replace_with_specific", "forbidden", "unobserved"]}, "evidence_refs": {"$ref": "#/$defs/refs"}}, "additionalProperties": false},
    "lint": {"type": "object", "required": ["finding_id", "rule_id", "source_refs", "locations", "impact", "suggestion", "evidence_refs"], "properties": {"finding_id": {"type": "string", "minLength": 1}, "rule_id": {"type": "string", "minLength": 1}, "source_refs": {"$ref": "#/$defs/refs"}, "locations": {"$ref": "#/$defs/refs"}, "impact": {"type": "string", "minLength": 1}, "suggestion": {"type": "string", "minLength": 1}, "evidence_refs": {"$ref": "#/$defs/refs"}}, "additionalProperties": false},
    "claim_result": {
      "type": "object",
      "required": ["claim_id", "category", "verdict", "evidence_refs", "conflict_refs", "residual_risks", "permitted_statement"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^CGM-[0-9]{3}$"},
        "category": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["supported", "contradicted", "not_evaluated"]},
        "evidence_refs": {"$ref": "#/$defs/refs"},
        "conflict_refs": {"$ref": "#/$defs/refs"},
        "residual_risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "permitted_statement": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"verdict": {"const": "supported"}}, "required": ["verdict"]}, "then": {"properties": {"evidence_refs": {"type": "array", "minItems": 1}, "conflict_refs": {"type": "array", "maxItems": 0}, "permitted_statement": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"verdict": {"enum": ["contradicted", "not_evaluated"]}}, "required": ["verdict"]}, "then": {"properties": {"permitted_statement": {"type": "null"}}}}
      ],
      "additionalProperties": false
    }
  }
}
