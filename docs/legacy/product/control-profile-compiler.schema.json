{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownhands.local/schemas/control-profile-compiler.schema.json",
  "title": "ownhands Control Profile Compiler Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["compiler_version", "contract_ref", "contract_fingerprint", "codex_version", "dry_run", "artifacts", "findings", "apply_ready", "restore", "realization", "diff_hash"],
  "properties": {
    "compiler_version": {"const": "1.0"}, "contract_ref": {"type": "string"}, "contract_fingerprint": {"$ref": "#/$defs/hash"}, "codex_version": {"type": "string"}, "dry_run": {"const": true},
    "artifacts": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["path", "artifact_type", "source_class", "content", "before_hash", "after_hash", "status"], "properties": {"path": {"type": "string"}, "artifact_type": {"enum": ["config", "agents", "rules", "hooks", "sandbox", "approval"]}, "source_class": {"enum": ["context", "control"]}, "content": {"type": "string"}, "before_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "after_hash": {"$ref": "#/$defs/hash"}, "status": {"enum": ["changed", "unchanged"]}}}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "severity", "basis", "location"], "properties": {"code": {"type": "string"}, "severity": {"const": "hard"}, "basis": {"enum": ["observed", "unobserved"]}, "location": {"type": "string"}}}},
    "apply_ready": {"type": "boolean"}, "restore": {"type": "object", "additionalProperties": false, "required": ["status", "journal_path"], "properties": {"status": {"enum": ["unavailable", "available"]}, "journal_path": {"type": ["string", "null"]}}},
    "realization": {"type": "object", "additionalProperties": false, "required": ["configured", "loaded", "enforced"], "properties": {"configured": {"$ref": "#/$defs/check"}, "loaded": {"$ref": "#/$defs/check"}, "enforced": {"$ref": "#/$defs/check"}}}, "diff_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "check": {"type": "object", "additionalProperties": false, "required": ["result", "basis"], "properties": {"result": {"const": "not_run"}, "basis": {"const": "unobserved"}}}}
}
