{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taejung3852/own-hands/docs/product/context-guarantee-matrix.schema.json",
  "title": "ownhands Context Guarantee Matrix proposal",
  "type": "object",
  "required": ["matrix_version", "status", "claims"],
  "properties": {
    "matrix_version": {"const": "1.5-proposed-1"},
    "status": {"const": "proposed"},
    "claims": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/claim"},
      "uniqueItems": true,
      "allOf": [
        {"contains": {"type": "object", "properties": {"category": {"const": "required_context_loaded"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"category": {"const": "relevant_skill_invoked"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"category": {"const": "conflicting_instruction_detected"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"category": {"const": "stale_context_identified"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"category": {"const": "context_profile_improved"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"category": {"const": "unobserved_context_path_exists"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "unique_strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "requirement": {
      "type": "object",
      "required": ["type", "required_fields"],
      "properties": {"type": {"enum": ["context_loading", "skill_invocation", "context_lint", "context_comparison", "unobserved_context_path"]}, "required_fields": {"$ref": "#/$defs/unique_strings"}},
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "category", "claim", "required_evidence", "allowed_basis", "forbidden_wording", "residual_risks"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^CGM-[0-9]{3}$"},
        "category": {"enum": ["required_context_loaded", "relevant_skill_invoked", "conflicting_instruction_detected", "stale_context_identified", "context_profile_improved", "unobserved_context_path_exists"]},
        "claim": {"type": "string", "minLength": 1},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}, "uniqueItems": true},
        "allowed_basis": {"type": "array", "minItems": 1, "items": {"enum": ["observed", "inferred"]}, "uniqueItems": true},
        "forbidden_wording": {"$ref": "#/$defs/unique_strings"},
        "residual_risks": {"$ref": "#/$defs/unique_strings"}
      },
      "additionalProperties": false
    }
  }
}
