{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/review-gate.js\" check-hook",
            "timeout": 10,
            "statusMessage": "Checking OwnHands review evidence..."
          }
        ]
      }
    ]
  }
}
